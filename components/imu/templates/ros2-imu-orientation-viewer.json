      "id": "imu_topic",
      "type": "ROS2",
      "pos": [80, 210],
      "params": {"action": "start", "topic": "/imu/data", "message_type": "sensor_msgs/msg/Imu", "node_name": "blacknode_imu_viewer", "history": 3, "timeout": 10.0, "stale_after_seconds": 1.0, "qos": "sensor_data"},
      "inputs": ["trigger", "device", "action", "topic", "message_type", "node_name", "history", "timeout", "stale_after_seconds", "qos"],
      "outputs": ["running", "message", "messages", "stream", "status", "received", "backend", "report"],
      "input_types": {"trigger": "Any", "device": "Dict", "action": "Text", "topic": "Text", "message_type": "Text", "node_name": "Text", "history": "Int", "timeout": "Float", "stale_after_seconds": "Float", "qos": "Text"},
      "output_types": {"running": "Bool", "message": "Dict", "messages": "List", "stream": "Dict", "status": "Dict", "received": "Int", "backend": "Text", "report": "Text"},
      "input_defaults": {"action": "status", "topic": "/scan", "message_type": "", "node_name": "blacknode_ros2_topic", "history": 10, "timeout": 10.0, "stale_after_seconds": 2.0, "qos": "sensor_data"}
    },
