      "inputs": ["action", "source", "viewer_id", "stale_after_seconds", "robot_length_m", "robot_width_m", "robot_height_m"],
      "outputs": ["running", "live", "scene", "status", "viewer", "report"],
      "input_types": {"action": "Text", "source": "Dict", "viewer_id": "Text", "stale_after_seconds": "Float", "robot_length_m": "Float", "robot_width_m": "Float", "robot_height_m": "Float"},
      "output_types": {"running": "Bool", "live": "Bool", "scene": "Dict", "status": "Dict", "viewer": "Dict", "report": "Text"},
      "input_defaults": {"action": "status", "viewer_id": "imu_viewer", "stale_after_seconds": 1.0, "robot_length_m": 0.36, "robot_width_m": 0.28, "robot_height_m": 0.12}
