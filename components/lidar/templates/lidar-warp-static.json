      "output_types": {"running": "Bool", "viewer": "Dict", "report": "Text"},
      "input_defaults": {"action": "stop", "viewer_id": "warp_lidar_static", "device": "cuda:0", "filter_min_m": 0.1, "filter_max_m": 12.0, "downsample_stride": 2, "sensor_x_m": 0.0, "sensor_y_m": 0.0, "sensor_yaw_rad": 0.0, "show_raw": true, "show_filtered": true, "point_radius_m": 0.025, "fps": 30, "animate_scan": true, "scan_hz": 0.25, "show_rays": true, "ray_trail_count": 96, "accumulate_hits": true, "compare_numpy": false}
